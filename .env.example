# ============================================================
# SISTEMA DE GERENCIAMENTO DE AGÊNCIA - VARIÁVEIS DE AMBIENTE
# ============================================================

# Chave secreta de autenticação JWT
JWT_SECRET=super_secret_jwt_key_creative_agency_2026_change_in_production

# Google Gemini API (Exclusivo no backend para o assistente de IA)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Google Calendar OAuth (Apenas para eventos da Agenda)
GOOGLE_CLIENT_ID=seu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Cloudflare D1 (Para deploy na Cloudflare)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# Fuso horário padrão
DEFAULT_TIMEZONE=America/Sao_Paulo
